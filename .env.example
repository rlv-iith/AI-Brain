# ============================================================
#  AI BRAIN CONFIG — copy to .env and fill in keys
# ============================================================

# ── Local SLM (laptop) ───────────────────────────────────────
MODEL_ID=microsoft/Phi-3.5-mini-instruct
SHARD_DIR=./model_shards
LOW_MEMORY=false           # true = load one layer at a time (~500 MB peak RAM)

# ── Home PC (Ollama via Cloudflare Tunnel) ───────────────────
# Setup guide: see scripts/home_pc_setup.md
HOME_PC_URL=               # e.g. https://your-tunnel.trycloudflare.com
HOME_PC_MODEL=llama3.2     # model pulled in Ollama on home PC

# ── Free Cloud LLMs ──────────────────────────────────────────

# xAI Grok — key starts with xai-  (NOT the same as Groq)
# Sign up: https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-3-mini              # or grok-3, grok-2-mini

# Groq  — DIFFERENT service, key starts with gsk_
# Sign up: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile   # or mixtral-8x7b-32768

# Google Gemini — large context, generous free tier
# Sign up: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Mistral — free tier (1 req/s)
# Sign up: https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenRouter — routes to many free models under one API
# Sign up: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Cerebras — very fast inference, free tier
# Sign up: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# ── Premium fallback ─────────────────────────────────────────
ANTHROPIC_API_KEY=         # Claude Sonnet 4.6 fallback
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Router mode ──────────────────────────────────────────────
# SINGLE   → use one provider (fastest for prod)
# RACE     → send to all, return first response
# COMPETE  → send to all, log time+quality, return best
ROUTER_MODE=RACE

# Which providers to include (comma-separated, order = priority)
# Options: local, home_pc, groq, gemini, mistral, openrouter, cerebras, anthropic
ACTIVE_PROVIDERS=groq,gemini,mistral

# ── Backend analytics logging ────────────────────────────────
# Set this so the AI Brain logs each chat to the Events sheet via the backend
BACKEND_URL=https://portfolio-server-3-ohjk.onrender.com

# ── Server ───────────────────────────────────────────────────
PORT=8000
ALLOWED_ORIGIN=http://localhost:5173
